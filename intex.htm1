
<!DOCTYPE html>
<html lang="sq">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ALBOPLAY</title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      min-height: 100vh;
      background: #080808;
      color: white;
      font-family: Arial, sans-serif;
      display: flex;
      justify-content: center;
      align-items: center;
    }

    .container {
      width: 100%;
      max-width: 430px;
      padding: 30px;
    }

    .logo {
      text-align: center;
      font-size: 38px;
      font-weight: bold;
      letter-spacing: 2px;
      margin-bottom: 10px;
    }

    .logo span {
      color: #ff1744;
    }

    .card {
      background: #151515;
      padding: 25px;
      border-radius: 18px;
      border: 1px solid #292929;
    }

    h1 {
      text-align: center;
      font-size: 25px;
      margin-bottom: 8px;
    }

    .subtitle {
      text-align: center;
      color: #999;
      margin-bottom: 25px;
    }

    label {
      display: block;
      margin-top: 16px;
      margin-bottom: 7px;
      font-size: 14px;
    }

    input {
      width: 100%;
      padding: 14px;
      border-radius: 10px;
      border: 1px solid #333;
      background: #0d0d0d;
      color: white;
      font-size: 15px;
    }

    button {
      width: 100%;
      margin-top: 25px;
      padding: 14px;
      border: none;
      border-radius: 10px;
      background: #ff1744;
      color: white;
      font-size: 16px;
      font-weight: bold;
      cursor: pointer;
    }

    .login {
      text-align: center;
      color: #999;
      margin-top: 20px;
      font-size: 14px;
    }

    .login a {
      color: #ff1744;
    }
  </style>
</head>

<body>

  <div class="container">

    <div class="logo">
      ALBO<span>PLAY</span>
    </div>

    <div class="card">

      <h1>Krijo llogari</h1>

      <div class="subtitle">
        Mirë se vjen në ALBOPLAY
      </div>

      <label>Emri i përdoruesit</label>
      <input type="text" placeholder="Shkruaj emrin e përdoruesit">

      <label>Email</label>
      <input type="email" placeholder="Shkruaj email-in">

      <label>Fjalëkalimi</label>
      <input type="password" placeholder="Shkruaj fjalëkalimin">

      <label>Konfirmo fjalëkalimin</label>
      <input type="password" placeholder="Përsërite fjalëkalimin">

      <button>REGJISTROHU</button>

      <div class="login">
        Ke tashmë llogari?
        <a href="#">Hyr këtu</a>
      </div>

    </div>

  </div>

</body>
</html>

